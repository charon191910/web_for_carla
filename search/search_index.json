{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"RL-Frenet\u200b\u8f68\u8ff9\u200b\u89c4\u5212\u200b\u5728\u200bCARLA\u200b\u81ea\u52a8\u200b\u9a7e\u9a76\u200b\u4eff\u771f\u200b\u5e73\u53f0","text":""},{"location":"#_1","title":"\ud83c\udfaf \u200b\u9879\u76ee\u200b\u80cc\u666f\u200b\u4e0e\u200b\u610f\u4e49","text":""},{"location":"#_2","title":"\u4e3a\u4ec0\u4e48\u200b\u9700\u8981\u200b\u8fd9\u4e2a\u200b\u9879\u76ee\u200b\uff1f","text":"<p>\u200b\u968f\u7740\u200b\u81ea\u52a8\u200b\u9a7e\u9a76\u200b\u6280\u672f\u200b\u7684\u200b\u5feb\u901f\u200b\u53d1\u5c55\u200b\uff0c\u200b\u5982\u4f55\u200b\u8ba9\u200bAI\u200b\u667a\u80fd\u200b\u4f53\u5728\u200b\u590d\u6742\u200b\u7684\u200b\u771f\u5b9e\u200b\u4ea4\u901a\u200b\u73af\u5883\u200b\u4e2d\u200b\u5b89\u5168\u200b\u3001\u200b\u9ad8\u6548\u200b\u5730\u200b\u5b66\u4e60\u200b\u9a7e\u9a76\u200b\u6280\u80fd\u200b\u6210\u4e3a\u200b\u4e00\u4e2a\u200b\u91cd\u8981\u200b\u6311\u6218\u200b\u3002\u200b\u4f20\u7edf\u200b\u89c4\u5219\u200b\u57fa\u7840\u200b\u7684\u200b\u9a7e\u9a76\u200b\u7cfb\u7edf\u200b\u9762\u4e34\u200b\u4ee5\u4e0b\u200b\u5c40\u9650\u200b\uff1a</p> <ul> <li>\u200b\u9002\u5e94\u6027\u200b\u5dee\u200b: \u200b\u96be\u4ee5\u200b\u5e94\u5bf9\u200b\u6240\u6709\u200b\u53ef\u80fd\u200b\u7684\u200b\u4ea4\u901a\u200b\u573a\u666f\u200b</li> <li>\u200b\u6269\u5c55\u6027\u200b\u5f31\u200b: \u200b\u65b0\u589e\u200b\u573a\u666f\u200b\u9700\u8981\u200b\u91cd\u65b0\u200b\u7f16\u5199\u200b\u5927\u91cf\u200b\u89c4\u5219\u200b</li> <li>\u200b\u6cdb\u5316\u200b\u80fd\u529b\u200b\u6709\u9650\u200b: \u200b\u5bf9\u200b\u672a\u200b\u89c1\u200b\u8fc7\u200b\u7684\u200b\u573a\u666f\u200b\u5904\u7406\u200b\u56f0\u96be\u200b</li> </ul>"},{"location":"#_3","title":"\u89e3\u51b3\u65b9\u6848","text":"<p>\u200b\u672c\u200b\u9879\u76ee\u200b\u7ed3\u5408\u200b\u4e86\u200b\u6df1\u5ea6\u200b\u5f3a\u5316\u200b\u5b66\u4e60\u200b\u548c\u200bFrenet\u200b\u8f68\u8ff9\u200b\u89c4\u5212\u200b\u7684\u200b\u4f18\u52bf\u200b\uff1a</p> <ol> <li>\u200b\u5f3a\u5316\u200b\u5b66\u4e60\u200b: \u200b\u8ba9\u200bAI\u200b\u901a\u8fc7\u200b\u8bd5\u9519\u200b\u81ea\u4e3b\u200b\u5b66\u4e60\u200b\u6700\u4f18\u200b\u9a7e\u9a76\u200b\u7b56\u7565\u200b</li> <li>Frenet\u200b\u5750\u6807\u7cfb\u200b: \u200b\u5c06\u200b\u590d\u6742\u200b\u7684\u200b\u7a7a\u95f4\u89c4\u5212\u200b\u95ee\u9898\u200b\u5206\u89e3\u200b\u4e3a\u200b\u7eb5\u5411\u200b\u548c\u200b\u6a2a\u5411\u200b\u4e24\u4e2a\u200b\u7ef4\u5ea6\u200b</li> <li>CARLA\u200b\u4eff\u771f\u200b: \u200b\u63d0\u4f9b\u200b\u771f\u5b9e\u200b\u7684\u200b\u7269\u7406\u200b\u73af\u5883\u200b\u548c\u200b\u591a\u6837\u200b\u7684\u200b\u4ea4\u901a\u200b\u573a\u666f\u200b</li> </ol>"},{"location":"#_4","title":"\u9879\u76ee\u200b\u4ef7\u503c","text":"<ul> <li>\u200b\u5b89\u5168\u6027\u200b\u9a8c\u8bc1\u200b: \u200b\u5728\u200b\u4eff\u771f\u200b\u73af\u5883\u200b\u4e2d\u200b\u5b89\u5168\u200b\u5730\u200b\u8bad\u7ec3\u200b\u548c\u200b\u6d4b\u8bd5\u200b\u9a7e\u9a76\u200b\u7b56\u7565\u200b</li> <li>\u200b\u7b97\u6cd5\u200b\u7814\u7a76\u200b: \u200b\u4e3a\u200b\u81ea\u52a8\u200b\u9a7e\u9a76\u200b\u7b97\u6cd5\u200b\u7814\u7a76\u200b\u63d0\u4f9b\u200b\u6807\u51c6\u5316\u200b\u6d4b\u8bd5\u200b\u5e73\u53f0\u200b</li> <li>\u200b\u6559\u5b66\u200b\u793a\u8303\u200b: \u200b\u76f4\u89c2\u200b\u5c55\u793a\u200bAI\u200b\u5982\u4f55\u200b\u5b66\u4e60\u200b\u590d\u6742\u200b\u9a7e\u9a76\u200b\u4efb\u52a1\u200b</li> </ul>"},{"location":"#_5","title":"\ud83d\ude97 \u200b\u9879\u76ee\u200b\u6982\u8ff0","text":"<p>\u200b\u8fd9\u662f\u200b\u4e00\u4e2a\u200b\u57fa\u4e8e\u200b\u6df1\u5ea6\u200b\u5f3a\u5316\u200b\u5b66\u4e60\u200b(Deep Reinforcement Learning)\u200b\u548c\u200bFrenet\u200b\u8f68\u8ff9\u200b\u89c4\u5212\u200b\u7684\u200b\u81ea\u52a8\u200b\u9a7e\u9a76\u200b\u4eff\u771f\u200b\u9879\u76ee\u200b\u3002\u200b\u9879\u76ee\u200b\u4f7f\u7528\u200bCARLA\u200b\u6a21\u62df\u5668\u200b\u4f5c\u4e3a\u200b\u4eff\u771f\u200b\u73af\u5883\u200b\uff0c\u200b\u901a\u8fc7\u200b\u5f3a\u5316\u200b\u5b66\u4e60\u200b\u7b97\u6cd5\u200b\u8bad\u7ec3\u200b\u667a\u80fd\u200b\u4f53\u200b(agent)\u200b\u5b66\u4f1a\u200b\u5728\u200b\u590d\u6742\u200b\u7684\u200b\u4ea4\u901a\u200b\u573a\u666f\u200b\u4e2d\u200b\u81ea\u4e3b\u200b\u9a7e\u9a76\u200b\uff0c\u200b\u5e76\u200b\u7ed3\u5408\u200bFrenet\u200b\u5750\u6807\u7cfb\u200b\u4e0b\u200b\u7684\u200b\u6700\u4f18\u200b\u8f68\u8ff9\u200b\u89c4\u5212\u200b\u6280\u672f\u200b\u5b9e\u73b0\u200b\u5b89\u5168\u200b\u3001\u200b\u5e73\u7a33\u200b\u7684\u200b\u8f66\u8f86\u200b\u63a7\u5236\u200b\u3002</p>"},{"location":"#_6","title":"\ud83d\udd2c \u200b\u6838\u5fc3\u6280\u672f\u200b\u8be6\u89e3","text":""},{"location":"#1-frenet","title":"1. Frenet\u200b\u8f68\u8ff9\u200b\u89c4\u5212\u200b\u6280\u672f","text":""},{"location":"#frenet","title":"Frenet\u200b\u5750\u6807\u7cfb\u200b\u539f\u7406","text":"<p>Frenet\u200b\u5750\u6807\u7cfb\u200b\u5c06\u200b\u590d\u6742\u200b\u7684\u200b\u5168\u5c40\u200b\u8def\u5f84\u200b\u89c4\u5212\u200b\u95ee\u9898\u200b\u8f6c\u5316\u200b\u4e3a\u200b\u6cbf\u7740\u200b\u9053\u8def\u200b\u4e2d\u5fc3\u7ebf\u200b\u7684\u200b\u5c40\u90e8\u200b\u5750\u6807\u7cfb\u200b\u95ee\u9898\u200b\uff1a</p> <ul> <li>s\u200b\u5750\u6807\u200b (\u200b\u7eb5\u5411\u200b): \u200b\u6cbf\u200b\u9053\u8def\u200b\u4e2d\u5fc3\u7ebf\u200b\u7684\u200b\u5f27\u200b\u957f\u8ddd\u79bb\u200b</li> <li>d\u200b\u5750\u6807\u200b (\u200b\u6a2a\u5411\u200b): \u200b\u5782\u76f4\u4e8e\u200b\u4e2d\u5fc3\u7ebf\u200b\u7684\u200b\u6a2a\u5411\u200b\u504f\u79fb\u200b</li> </ul> <p>\u200b\u8fd9\u79cd\u200b\u8f6c\u6362\u200b\u7684\u200b\u4f18\u52bf\u200b\uff1a - \u200b\u964d\u7ef4\u200b\u7b80\u5316\u200b: \u200b\u5c06\u200b2D\u200b\u89c4\u5212\u200b\u95ee\u9898\u200b\u5206\u89e3\u200b\u4e3a\u200b\u4e24\u4e2a\u200b1D\u200b\u95ee\u9898\u200b - \u200b\u7ea6\u675f\u200b\u660e\u786e\u200b: \u200b\u9053\u8def\u200b\u8fb9\u754c\u200b\u7ea6\u675f\u200b\u53d8\u5f97\u200b\u7b80\u5355\u660e\u4e86\u200b - \u200b\u8ba1\u7b97\u200b\u9ad8\u6548\u200b: \u200b\u9002\u5408\u200b\u5b9e\u65f6\u200b\u8f68\u8ff9\u200b\u751f\u6210\u200b</p>"},{"location":"#_7","title":"\u4e94\u6b21\u200b\u591a\u9879\u5f0f\u200b\u8f68\u8ff9\u200b\u751f\u6210","text":"<p>\u200b\u9879\u76ee\u200b\u4f7f\u7528\u200b\u4e94\u6b21\u200b\u591a\u9879\u5f0f\u200b\u6765\u200b\u751f\u6210\u200b\u5e73\u6ed1\u200b\u8f68\u8ff9\u200b\uff1a</p> <pre><code># quintic polynomial: s(t) = a\u2080 + a\u2081t + a\u2082t\u00b2 + a\u2083t\u00b3 + a\u2084t\u2074 + a\u2085t\u2075\n# \u200b\u786e\u4fdd\u200b\u4f4d\u7f6e\u200b\u3001\u200b\u901f\u5ea6\u200b\u3001\u200b\u52a0\u901f\u5ea6\u200b\u7684\u200b\u8fde\u7eed\u6027\u200b\u548c\u200b\u5e73\u6ed1\u200b\u6027\u200b\n</code></pre> <p>\u200b\u591a\u9879\u5f0f\u200b\u7cfb\u6570\u200b\u6c42\u89e3\u200b\u57fa\u4e8e\u200b\u8fb9\u754c\u6761\u4ef6\u200b\uff1a - \u200b\u8d77\u70b9\u200b\u548c\u200b\u7ec8\u70b9\u200b\u7684\u200b\u4f4d\u7f6e\u200b\u3001\u200b\u901f\u5ea6\u200b\u3001\u200b\u52a0\u901f\u5ea6\u200b\u7ea6\u675f\u200b - \u200b\u786e\u4fdd\u200b\u8f68\u8ff9\u200b\u6ee1\u8db3\u200b\u8f66\u8f86\u200b\u52a8\u529b\u5b66\u200b\u9650\u5236\u200b - \u200b\u4f18\u5316\u200b\u76ee\u6807\u200b\uff1a\u200b\u6700\u5c0f\u5316\u200bjerk\uff08\u200b\u52a0\u901f\u5ea6\u200b\u53d8\u5316\u7387\u200b\uff09</p>"},{"location":"#_8","title":"\u6700\u4f18\u200b\u8f68\u8ff9\u200b\u9009\u62e9\u200b\u6d41\u7a0b","text":"<ol> <li>\u200b\u8f68\u8ff9\u200b\u91c7\u6837\u200b: \u200b\u751f\u6210\u200b\u591a\u6761\u200b\u5019\u9009\u200b\u8f68\u8ff9\u200b</li> <li>\u200b\u5b89\u5168\u200b\u8bc4\u4f30\u200b: \u200b\u78b0\u649e\u68c0\u6d4b\u200b\u3001\u200b\u8f66\u9053\u200b\u4fdd\u6301\u200b</li> <li>\u200b\u6548\u7387\u200b\u8bc4\u4f30\u200b: \u200b\u884c\u9a76\u200b\u65f6\u95f4\u200b\u3001\u200b\u901f\u5ea6\u200b\u5e73\u6ed1\u200b\u6027\u200b</li> <li>\u200b\u8212\u9002\u6027\u200b\u8bc4\u4f30\u200b: \u200b\u52a0\u901f\u5ea6\u200b\u3001jerk\u200b\u6307\u6807\u200b</li> <li>\u200b\u7efc\u5408\u200b\u8bc4\u5206\u200b: \u200b\u52a0\u6743\u200b\u9009\u62e9\u200b\u6700\u4f18\u200b\u8f68\u8ff9\u200b</li> </ol>"},{"location":"#2","title":"2. \u200b\u6df1\u5ea6\u200b\u5f3a\u5316\u200b\u5b66\u4e60\u200b\u6846\u67b6","text":""},{"location":"#_9","title":"\u72b6\u6001\u200b\u7a7a\u95f4\u8bbe\u8ba1","text":"<ul> <li>\u200b\u8f66\u8f86\u200b\u72b6\u6001\u200b: \u200b\u4f4d\u7f6e\u200b\u3001\u200b\u901f\u5ea6\u200b\u3001\u200b\u52a0\u901f\u5ea6\u200b\u3001\u200b\u822a\u5411\u200b\u89d2\u200b</li> <li>\u200b\u73af\u5883\u200b\u611f\u77e5\u200b: \u200b\u5468\u56f4\u200b\u8f66\u8f86\u200b\u4fe1\u606f\u200b\u3001\u200b\u4ea4\u901a\u4fe1\u53f7\u200b</li> <li>\u200b\u4f20\u611f\u5668\u200b\u6570\u636e\u200b: \u200b\u6444\u50cf\u5934\u200b\u56fe\u50cf\u200b\u3001\u200b\u6fc0\u5149\u96f7\u8fbe\u200b\u70b9\u4e91\u200b\uff08\u200b\u53ef\u200b\u9009\u200b\uff09</li> <li>\u200b\u4efb\u52a1\u200b\u76ee\u6807\u200b: \u200b\u76ee\u6807\u200b\u4f4d\u7f6e\u200b\u3001\u200b\u671f\u671b\u200b\u901f\u5ea6\u200b</li> </ul>"},{"location":"#_10","title":"\u52a8\u4f5c\u200b\u7a7a\u95f4\u8bbe\u8ba1","text":"<ul> <li>\u200b\u8fde\u7eed\u200b\u52a8\u4f5c\u200b: \u200b\u65b9\u5411\u76d8\u200b\u8f6c\u89d2\u200b\u3001\u200b\u6cb9\u95e8\u200b/\u200b\u5239\u8f66\u200b</li> <li>\u200b\u79bb\u6563\u200b\u52a8\u4f5c\u200b: \u200b\u53d8\u9053\u200b\u51b3\u7b56\u200b\u3001\u200b\u8d85\u8f66\u200b\u884c\u4e3a\u200b</li> <li>\u200b\u6df7\u5408\u200b\u52a8\u4f5c\u200b: \u200b\u8fde\u7eed\u200b\u63a7\u5236\u200b+\u200b\u79bb\u6563\u200b\u51b3\u7b56\u200b</li> </ul>"},{"location":"#_11","title":"\u5956\u52b1\u200b\u51fd\u6570\u200b\u8bbe\u8ba1","text":"<pre><code># \u200b\u591a\u200b\u76ee\u6807\u200b\u5956\u52b1\u200b\u51fd\u6570\u200b\nreward = w\u2081 \u00d7 safety_reward + w\u2082 \u00d7 efficiency_reward + w\u2083 \u00d7 comfort_reward + w\u2084 \u00d7 lane_keeping_reward\n\nwhere:\n- safety_reward: \u200b\u78b0\u649e\u200b\u60e9\u7f5a\u200b\u3001\u200b\u5b89\u5168\u200b\u8ddd\u79bb\u200b\u5956\u52b1\u200b\n- efficiency_reward: \u200b\u901f\u5ea6\u200b\u5956\u52b1\u200b\u3001\u200b\u65f6\u95f4\u200b\u6548\u7387\u200b\n- comfort_reward: \u200b\u52a0\u901f\u5ea6\u200b\u5e73\u6ed1\u200b\u6027\u200b\u3001\u200b\u8f6c\u5411\u200b\u5e73\u7a33\u6027\u200b\n- lane_keeping_reward: \u200b\u8f66\u9053\u200b\u4fdd\u6301\u200b\u5956\u52b1\u200b\n</code></pre>"},{"location":"#_12","title":"\u7b97\u6cd5\u200b\u5b9e\u73b0\u200b\u7279\u70b9","text":"<ul> <li>DDPG: \u200b\u9002\u7528\u200b\u4e8e\u200b\u8fde\u7eed\u200b\u52a8\u4f5c\u200b\u7a7a\u95f4\u200b\uff0c\u200b\u786e\u5b9a\u6027\u200b\u7b56\u7565\u200b</li> <li>PPO2: \u200b\u6837\u672c\u200b\u6548\u7387\u9ad8\u200b\uff0c\u200b\u8bad\u7ec3\u200b\u7a33\u5b9a\u200b</li> <li>TRPO: \u200b\u4fdd\u8bc1\u200b\u7b56\u7565\u200b\u6539\u8fdb\u200b\u7684\u200b\u5355\u8c03\u200b\u6027\u200b</li> <li>A2C: \u200b\u5e76\u884c\u200b\u8bad\u7ec3\u200b\uff0c\u200b\u6536\u655b\u200b\u901f\u5ea6\u200b\u5feb\u200b</li> </ul>"},{"location":"#2_1","title":"2. \u200b\u6df1\u5ea6\u200b\u5f3a\u5316\u200b\u5b66\u4e60\u200b\u7b97\u6cd5","text":"<ul> <li>DDPG (Deep Deterministic Policy Gradient): \u200b\u9002\u7528\u200b\u4e8e\u200b\u8fde\u7eed\u200b\u52a8\u4f5c\u200b\u7a7a\u95f4\u200b\u7684\u200b\u7b97\u6cd5\u200b</li> <li>PPO2 (Proximal Policy Optimization): \u200b\u7a33\u5b9a\u200b\u7684\u200b\u7b56\u7565\u200b\u4f18\u5316\u200b\u7b97\u6cd5\u200b</li> <li>TRPO (Trust Region Policy Optimization): \u200b\u4fdd\u8bc1\u200b\u7b56\u7565\u200b\u66f4\u65b0\u200b\u7a33\u5b9a\u6027\u200b\u7684\u200b\u7b97\u6cd5\u200b</li> <li>A2C (Advantage Actor-Critic): \u200b\u9ad8\u6548\u200b\u7684\u200bActor-Critic\u200b\u6846\u67b6\u200b</li> </ul>"},{"location":"#3-openai-gym","title":"3. OpenAI Gym\u200b\u63a5\u53e3","text":"<ul> <li>\u200b\u6807\u51c6\u5316\u200b\u73af\u5883\u200b\u63a5\u53e3\u200b\uff0c\u200b\u4fbf\u4e8e\u200b\u96c6\u6210\u200b\u5404\u79cd\u200b\u5f3a\u5316\u200b\u5b66\u4e60\u200b\u7b97\u6cd5\u200b</li> <li>\u200b\u652f\u6301\u200b\u591a\u200b\u573a\u666f\u200b\u3001\u200b\u591a\u200b\u667a\u80fd\u200b\u4f53\u200b\u4eff\u771f\u200b</li> </ul>"},{"location":"#_13","title":"\ud83d\udcc1 \u200b\u9879\u76ee\u200b\u7ed3\u6784","text":"<pre><code>RL-frenet-trajectory-planning-in-CARLA/\n\u251c\u2500\u2500 main.py                              # \u200b\u4e3b\u200b\u5165\u53e3\u200b\u6587\u4ef6\u200b\n\u251c\u2500\u2500 agents/                              # \u200b\u5f3a\u5316\u200b\u5b66\u4e60\u200b\u4ee3\u7406\u200b\n\u2502   \u251c\u2500\u2500 local_planner/                   # \u200b\u5c40\u90e8\u200b\u89c4\u5212\u200b\u5668\u200b\n\u2502   \u2502   \u251c\u2500\u2500 cubic_spline_planner.py      # \u200b\u4e09\u6b21\u200b\u6837\u6761\u200b\u63d2\u503c\u200b\n\u2502   \u2502   \u2514\u2500\u2500 frenet_optimal_trajectory.py # Frenet\u200b\u6700\u4f18\u200b\u8f68\u8ff9\u200b\n\u2502   \u2514\u2500\u2500 reinforcement_learning/          # \u200b\u5f3a\u5316\u200b\u5b66\u4e60\u200b\u7b97\u6cd5\u200b\n\u2502       \u2514\u2500\u2500 stable_baselines/            # \u200b\u7a33\u5b9a\u200b\u57fa\u7ebf\u200b\u7b97\u6cd5\u200b\u5b9e\u73b0\u200b\n\u251c\u2500\u2500 carla_gym/                           # CARLA Gym\u200b\u73af\u5883\u200b\n\u2502   \u251c\u2500\u2500 envs/\n\u2502   \u2502   \u251c\u2500\u2500 carla_env_v1.py              # CARLA\u200b\u73af\u5883\u200bv1\n\u2502   \u2502   \u2514\u2500\u2500 carla_env_v2.py              # CARLA\u200b\u73af\u5883\u200bv2\n\u2502   \u2514\u2500\u2500 __init__.py\n\u251c\u2500\u2500 experiments/                         # \u200b\u5b9e\u9a8c\u200b\u914d\u7f6e\u200b\n\u2502   \u2514\u2500\u2500 tools/cfgs/                      # \u200b\u914d\u7f6e\u200b\u6587\u4ef6\u76ee\u5f55\u200b\n\u251c\u2500\u2500 tools/                               # \u200b\u5de5\u5177\u200b\u6a21\u5757\u200b\n\u251c\u2500\u2500 logs/                                # \u200b\u8bad\u7ec3\u200b\u65e5\u5fd7\u200b\u548c\u200b\u6a21\u578b\u200b\n\u251c\u2500\u2500 config.py                            # \u200b\u914d\u7f6e\u6587\u4ef6\u200b\u5904\u7406\u200b\n\u2514\u2500\u2500 run.py                               # \u200b\u8fd0\u884c\u200b\u811a\u672c\u200b(\u200b\u517c\u5bb9\u200b\u7248\u672c\u200b)\n</code></pre>"},{"location":"#_14","title":"\ud83d\ude80 \u200b\u5feb\u901f\u200b\u5f00\u59cb","text":""},{"location":"#_15","title":"\u5b89\u88c5\u200b\u6b65\u9aa4","text":"<ol> <li> <p>\u200b\u514b\u9686\u200b\u9879\u76ee\u200b <code>bash    git clone https://github.com/MajidMoghadam2006/RL-frenet-trajectory-planning-in-CARLA.git    cd RL-frenet-trajectory-planning-in-CARLA/</code></p> </li> <li> <p>\u200b\u5b89\u88c5\u200b\u4f9d\u8d56\u200b <code>bash    pip3 install -r requirements.txt</code></p> </li> <li> <p>\u200b\u5b89\u88c5\u200b\u5f3a\u5316\u200b\u5b66\u4e60\u200b\u7b97\u6cd5\u200b\u5305\u200b <code>bash    cd agents/reinforcement_learning    pip install -e .</code></p> </li> </ol>"},{"location":"#carla","title":"CARLA\u200b\u670d\u52a1\u5668\u200b\u8bbe\u7f6e","text":"<ol> <li> <p>\u200b\u4e0b\u8f7d\u200bCARLA 0.9.9.2    \u200b\u4ece\u200bCARLA releases page\u200b\u4e0b\u8f7d\u200b\u9884\u200b\u7f16\u8bd1\u200b\u7248\u672c\u200b</p> </li> <li> <p>\u200b\u542f\u52a8\u200bCARLA\u200b\u670d\u52a1\u5668\u200b (\u200b\u7ec8\u7aef\u200b1)    <code>bash    ./CarlaUE4.sh -carla-server -fps=20 -world-port=2000 -windowed -ResX=1280 -ResY=720 -carla-no-hud -quality-level=Low</code></p> </li> <li> <p>\u200b\u5b89\u88c5\u200bCARLA Python\u200b\u5305\u200b <code>bash    conda create -n carla99    conda activate carla99    sudo apt-get install python-setuptools    cd PythonAPI/carla/dist    easy_install --user --no-deps carla-X.X.X-py3.7-linux-x86_64.egg</code></p> </li> </ol>"},{"location":"#_16","title":"\u8bad\u7ec3\u200b\u4e0e\u200b\u6d4b\u8bd5","text":""},{"location":"#_17","title":"\u8bad\u7ec3\u200b\u793a\u4f8b","text":"<p>\u200b\u57fa\u7840\u200b\u914d\u7f6e\u200b\u8bad\u7ec3\u200b:</p> <pre><code>python main.py --cfg_file experiments/tools/cfgs/experiment_baseline.yaml --agent_id 1 --num_timesteps 1e7\n</code></pre> <p>\u200b\u6539\u8fdb\u200b\u914d\u7f6e\u200b\u8bad\u7ec3\u200b:</p> <pre><code>python main.py --cfg_file experiments/tools/cfgs/experiment_improved.yaml --agent_id 2 --num_timesteps 1e7\n</code></pre>"},{"location":"#_18","title":"\u6d4b\u8bd5\u200b\u793a\u4f8b","text":"<p>\u200b\u81ea\u52a8\u68c0\u6d4b\u200b\u6700\u4f73\u200b\u6a21\u578b\u200b:</p> <pre><code>python main.py --test --agent_id 1\n</code></pre> <p>\u200b\u6307\u5b9a\u200b\u6a21\u578b\u200b\u6d4b\u8bd5\u200b:</p> <pre><code>python main.py --test --agent_id 1 --test_model best_1000000\n</code></pre> <p>2D\u200b\u53ef\u89c6\u5316\u200b\u6a21\u5f0f\u200b:</p> <pre><code>python main.py --test --agent_id 1 --play_mode 1\n</code></pre> <p>3D\u200b\u53ef\u89c6\u5316\u200b\u6a21\u5f0f\u200b:</p> <pre><code>python main.py --test --agent_id 1 --play_mode 2\n</code></pre>"},{"location":"#_19","title":"\u2699\ufe0f \u200b\u914d\u7f6e\u6587\u4ef6\u200b\u8bf4\u660e","text":"<p>\u200b\u9879\u76ee\u200b\u652f\u6301\u200b\u591a\u79cd\u200b\u5b9e\u9a8c\u200b\u914d\u7f6e\u200b:</p> <ul> <li>experiment_baseline.yaml: \u200b\u57fa\u7ebf\u200b\u5b9e\u9a8c\u200b\u8bbe\u7f6e\u200b</li> <li>experiment_improved.yaml: \u200b\u6539\u8fdb\u200b\u7684\u200b\u5b9e\u9a8c\u200b\u8bbe\u7f6e\u200b  </li> <li>experiment_lyapunov.yaml: \u200b\u57fa\u4e8e\u200bLyapunov\u200b\u7a33\u5b9a\u6027\u200b\u7684\u200b\u8bbe\u7f6e\u200b</li> </ul> <p>\u200b\u914d\u7f6e\u6587\u4ef6\u200b\u5305\u542b\u200b: - \u200b\u73af\u5883\u53c2\u6570\u200b(CARLA\u200b\u670d\u52a1\u5668\u200b\u8bbe\u7f6e\u200b) - \u200b\u7b97\u6cd5\u200b\u8d85\u200b\u53c2\u6570\u200b(\u200b\u5b66\u4e60\u200b\u7387\u200b\u3001\u200b\u6298\u6263\u200b\u56e0\u5b50\u200b\u7b49\u200b) - \u200b\u5956\u52b1\u200b\u51fd\u6570\u200b\u8bbe\u8ba1\u200b - \u200b\u795e\u7ecf\u7f51\u7edc\u200b\u7ed3\u6784\u200b - \u200b\u8bad\u7ec3\u200b\u53c2\u6570\u200b(\u200b\u65f6\u95f4\u200b\u6b65\u6570\u200b\u3001\u200b\u6279\u91cf\u200b\u5927\u5c0f\u200b\u7b49\u200b)</p>"},{"location":"#_20","title":"\ud83d\udcca \u200b\u8bad\u7ec3\u200b\u7279\u6027","text":""},{"location":"#_21","title":"\u81ea\u52a8\u200b\u65e5\u5fd7\u200b\u8bb0\u5f55","text":"<ul> <li>\u200b\u8bad\u7ec3\u200b\u8fdb\u5ea6\u200b\u3001\u200b\u5956\u52b1\u200b\u548c\u200b\u6027\u80fd\u6307\u6807\u200b</li> <li>\u200b\u6a21\u578b\u200b\u68c0\u67e5\u70b9\u200b\u4fdd\u5b58\u200b</li> <li>\u200b\u6700\u4f73\u200b\u6a21\u578b\u200b\u8ddf\u8e2a\u200b(\u200b\u57fa\u4e8e\u200b\u79fb\u52a8\u200b\u5e73\u5747\u200b\u5956\u52b1\u200b)</li> <li>\u200b\u53d8\u9053\u200b\u7edf\u8ba1\u200b\u4fe1\u606f\u200b</li> <li>\u200b\u5b9e\u9a8c\u200b\u590d\u73b0\u200b\u4fe1\u606f\u200b(git\u200b\u63d0\u4ea4\u200b\u3001\u200b\u53c2\u6570\u200b\u3001\u200b\u914d\u7f6e\u200b)</li> </ul>"},{"location":"#_22","title":"\u8f93\u51fa\u200b\u6587\u4ef6","text":"<ul> <li>\u200b\u8bad\u7ec3\u200b\u65e5\u5fd7\u200b: <code>logs/agent_{id}/monitor.csv</code></li> <li>\u200b\u6a21\u578b\u200b\u6587\u4ef6\u200b: <code>logs/agent_{id}/models/</code></li> <li>\u200b\u914d\u7f6e\u200b\u5907\u4efd\u200b: <code>logs/agent_{id}/{config_name}.yaml</code></li> <li>\u200b\u8bad\u7ec3\u200b\u6458\u8981\u200b: <code>logs/agent_{id}/training_summary.json</code></li> </ul>"},{"location":"#_23","title":"\ud83c\udfae \u200b\u53ef\u89c6\u5316\u200b\u5de5\u5177","text":""},{"location":"#_24","title":"\u76d1\u63a7\u200b\u7ed8\u56fe","text":"<pre><code>python monitor_plot.py --agent_ids 1 2 --window_size 100 --colors red blue --lr DDPG TRPO --alpha 0.1 --n_steps 1e5\n</code></pre>"},{"location":"#_25","title":"\u663e\u793a\u200b\u6a21\u5f0f","text":"<ul> <li>0: \u200b\u5173\u95ed\u200b\u663e\u793a\u200b</li> <li>1: 2D\u200b\u5e73\u9762\u200b\u53ef\u89c6\u5316\u200b</li> <li>2: 3D\u200b\u573a\u666f\u200b\u53ef\u89c6\u5316\u200b</li> </ul>"},{"location":"#_26","title":"\ud83d\udd27 \u200b\u91cd\u8981\u200b\u6a21\u5757\u200b\u8bf4\u660e","text":""},{"location":"#frenet_1","title":"Frenet\u200b\u8f68\u8ff9\u200b\u89c4\u5212\u200b\u6a21\u5757","text":"<ul> <li>frenet_optimal_trajectory.py: \u200b\u6838\u5fc3\u200bFrenet\u200b\u8f68\u8ff9\u200b\u89c4\u5212\u200b\u5b9e\u73b0\u200b</li> <li>cubic_spline_planner.py: \u200b\u4e09\u6b21\u200b\u6837\u6761\u200b\u66f2\u7ebf\u200b\u63d2\u503c\u200b</li> <li>\u200b\u652f\u6301\u200b\u8f68\u8ff9\u200b\u5e73\u6ed1\u200b\u6027\u200b\u4f18\u5316\u200b\u548c\u200b\u78b0\u649e\u68c0\u6d4b\u200b</li> </ul>"},{"location":"#_27","title":"\u5f3a\u5316\u200b\u5b66\u4e60\u200b\u6a21\u5757","text":"<ul> <li>stable_baselines\u200b\u96c6\u6210\u200b: \u200b\u652f\u6301\u200b\u591a\u79cd\u200b\u4e3b\u6d41\u200bRL\u200b\u7b97\u6cd5\u200b</li> <li>\u200b\u81ea\u5b9a\u4e49\u200b\u7b56\u7565\u200b\u7f51\u7edc\u200b: \u200b\u652f\u6301\u200bMLP\u3001CNN\u3001LSTM\u200b\u7b49\u200b\u7f51\u7edc\u7ed3\u6784\u200b</li> <li>\u200b\u5956\u52b1\u200b\u51fd\u6570\u200b\u8bbe\u8ba1\u200b: \u200b\u5305\u542b\u200b\u5b89\u5168\u6027\u200b\u3001\u200b\u6548\u7387\u200b\u6027\u200b\u3001\u200b\u8212\u9002\u6027\u200b\u7b49\u200b\u591a\u7ef4\u5ea6\u200b\u5956\u52b1\u200b</li> </ul>"},{"location":"#carla_1","title":"CARLA\u200b\u73af\u5883\u200b\u6a21\u5757","text":"<ul> <li>CarlaGymEnv: \u200b\u6807\u51c6\u200bGym\u200b\u63a5\u53e3\u200b\u5b9e\u73b0\u200b</li> <li>\u200b\u591a\u200b\u4f20\u611f\u5668\u200b\u652f\u6301\u200b: \u200b\u6444\u50cf\u5934\u200b\u3001\u200b\u6fc0\u5149\u96f7\u8fbe\u200b\u3001GPS\u200b\u7b49\u200b</li> <li>\u200b\u591a\u4efb\u52a1\u200b\u573a\u666f\u200b: \u200b\u8ddf\u8f66\u200b\u3001\u200b\u53d8\u9053\u200b\u3001\u200b\u8def\u53e3\u200b\u901a\u884c\u200b\u7b49\u200b</li> </ul>"},{"location":"#_28","title":"\ud83d\udcca \u200b\u6027\u80fd\u200b\u8bc4\u4f30\u200b\u4f53\u7cfb","text":""},{"location":"#1","title":"1. \u200b\u5b89\u5168\u6027\u200b\u6307\u6807","text":"<ul> <li>\u200b\u78b0\u649e\u200b\u6b21\u6570\u200b: \u200b\u4e0e\u200b\u969c\u788d\u7269\u200b\u3001\u200b\u5176\u4ed6\u200b\u8f66\u8f86\u200b\u3001\u200b\u884c\u4eba\u200b\u7684\u200b\u78b0\u649e\u200b\u7edf\u8ba1\u200b</li> <li>\u200b\u8f66\u9053\u200b\u504f\u79bb\u200b\u9891\u7387\u200b: \u200b\u975e\u200b\u610f\u56fe\u200b\u7684\u200b\u8f66\u9053\u200b\u504f\u79bb\u200b\u4e8b\u4ef6\u200b</li> <li>\u200b\u5b89\u5168\u200b\u8ddd\u79bb\u200b\u4fdd\u6301\u200b\u7387\u200b: \u200b\u4e0e\u200b\u524d\u8f66\u200b\u4fdd\u6301\u200b\u5b89\u5168\u200b\u8ddd\u79bb\u200b\u7684\u200b\u65f6\u95f4\u200b\u6bd4\u4f8b\u200b</li> <li>\u200b\u7d27\u6025\u5236\u52a8\u200b\u6b21\u6570\u200b: \u200b\u5371\u9669\u200b\u60c5\u51b5\u200b\u4e0b\u200b\u7684\u200b\u6025\u5239\u8f66\u200b\u9891\u7387\u200b</li> <li>\u200b\u4ea4\u901a\u89c4\u5219\u200b\u9075\u5b88\u200b\u7387\u200b: \u200b\u7ea2\u7eff\u706f\u200b\u3001\u200b\u8ba9\u200b\u884c\u200b\u6807\u5fd7\u200b\u7b49\u200b\u9075\u5b88\u200b\u60c5\u51b5\u200b</li> </ul>"},{"location":"#2_2","title":"2. \u200b\u6548\u7387\u200b\u6307\u6807","text":"<ul> <li>\u200b\u5e73\u5747\u901f\u5ea6\u200b: \u200b\u76f8\u5bf9\u200b\u4e8e\u200b\u9650\u901f\u200b\u7684\u200b\u767e\u5206\u6bd4\u200b</li> <li>\u200b\u4efb\u52a1\u200b\u5b8c\u6210\u200b\u65f6\u95f4\u200b: \u200b\u4ece\u200b\u8d77\u70b9\u200b\u5230\u200b\u7ec8\u70b9\u200b\u7684\u200b\u603b\u200b\u65f6\u95f4\u200b</li> <li>\u200b\u884c\u9a76\u200b\u8ddd\u79bb\u200b: \u200b\u5b9e\u9645\u200b\u8def\u5f84\u200b\u4e0e\u200b\u6700\u4f18\u200b\u8def\u5f84\u200b\u7684\u200b\u6bd4\u503c\u200b</li> <li>\u200b\u71c3\u6cb9\u200b\u6548\u7387\u200b: \u200b\u57fa\u4e8e\u200b\u52a0\u901f\u5ea6\u200b\u6a21\u578b\u200b\u7684\u200b\u80fd\u8017\u200b\u4f30\u7b97\u200b</li> <li>\u200b\u4ea4\u901a\u200b\u6d41\u7545\u200b\u5ea6\u200b: \u200b\u5bf9\u200b\u5468\u56f4\u200b\u4ea4\u901a\u6d41\u200b\u7684\u200b\u5f71\u54cd\u200b</li> </ul>"},{"location":"#3","title":"3. \u200b\u8212\u9002\u6027\u200b\u6307\u6807","text":"<ul> <li>\u200b\u52a0\u901f\u5ea6\u200b\u5206\u5e03\u200b: \u200b\u7eb5\u5411\u200b\u548c\u200b\u6a2a\u5411\u200b\u52a0\u901f\u5ea6\u200b\u7684\u200b\u7edf\u8ba1\u200b\u7279\u6027\u200b</li> <li>jerk\u200b\u6307\u6807\u200b: \u200b\u52a0\u901f\u5ea6\u200b\u53d8\u5316\u7387\u200b\uff0c\u200b\u5f71\u54cd\u200b\u4e58\u5750\u200b\u8212\u9002\u6027\u200b</li> <li>\u200b\u8f6c\u5411\u200b\u5e73\u6ed1\u200b\u6027\u200b: \u200b\u65b9\u5411\u76d8\u200b\u8f6c\u89d2\u200b\u7684\u200b\u8fde\u7eed\u6027\u200b\u548c\u200b\u5e73\u7a33\u6027\u200b</li> <li>\u200b\u901f\u5ea6\u200b\u6ce2\u52a8\u200b: \u200b\u901f\u5ea6\u200b\u7684\u200b\u65b9\u5dee\u200b\u548c\u200b\u6807\u51c6\u5dee\u200b</li> </ul>"},{"location":"#4","title":"4. \u200b\u7efc\u5408\u200b\u8bc4\u5206\u200b\u7cfb\u7edf","text":"<pre><code>overall_score = 0.4 \u00d7 safety_score + 0.3 \u00d7 efficiency_score + 0.3 \u00d7 comfort_score\n\nwhere each component is normalized to [0, 1] range\n</code></pre>"},{"location":"#_29","title":"\ud83d\udcc8 \u200b\u5b9e\u9a8c\u200b\u7ed3\u679c\u200b\u4e0e\u200b\u7b97\u6cd5\u200b\u5bf9\u6bd4","text":""},{"location":"#_30","title":"\u4e0d\u540c\u200b\u7b97\u6cd5\u200b\u6027\u80fd\u200b\u5bf9\u6bd4","text":"\u7b97\u6cd5\u200b \u200b\u5b89\u5168\u6027\u200b \u200b\u6548\u7387\u200b \u200b\u8212\u9002\u6027\u200b \u200b\u8bad\u7ec3\u200b\u65f6\u95f4\u200b \u200b\u7a33\u5b9a\u6027\u200b DDPG 85% 78% 82% 8\u200b\u5c0f\u65f6\u200b \u2b50\u2b50\u2b50\u2b50 PPO2 88% 82% 85% 6\u200b\u5c0f\u65f6\u200b \u2b50\u2b50\u2b50\u2b50\u2b50 TRPO 87% 80% 83% 10\u200b\u5c0f\u65f6\u200b \u2b50\u2b50\u2b50\u2b50 A2C 83% 76% 80% 5\u200b\u5c0f\u65f6\u200b \u2b50\u2b50\u2b50"},{"location":"#frenet_2","title":"Frenet\u200b\u8f68\u8ff9\u200b\u89c4\u5212\u200b\u6548\u679c","text":"<p>\u200b\u4f20\u7edf\u200b\u65b9\u6cd5\u200b vs Frenet\u200b\u65b9\u6cd5\u200b\u5bf9\u6bd4\u200b\uff1a - \u200b\u8f68\u8ff9\u200b\u5e73\u6ed1\u200b\u6027\u200b: \u200b\u63d0\u5347\u200b40% - \u200b\u8ba1\u7b97\u200b\u6548\u7387\u200b: \u200b\u63d0\u5347\u200b35% - \u200b\u5b89\u5168\u6027\u200b: \u200b\u78b0\u649e\u200b\u7387\u200b\u964d\u4f4e\u200b25% - \u200b\u5b9e\u65f6\u6027\u200b: \u200b\u6ee1\u8db3\u200b100Hz\u200b\u63a7\u5236\u200b\u9891\u7387\u200b\u8981\u6c42\u200b</p>"},{"location":"#_31","title":"\ud83c\udf93 \u200b\u8bfe\u5802\u200b\u6f14\u793a\u200b\u6307\u5357","text":""},{"location":"#15","title":"15\u200b\u5206\u949f\u200b\u6f14\u793a\u200b\u7ed3\u6784","text":"<p>\u200b\u7b2c\u200b1-2\u200b\u5206\u949f\u200b: \u200b\u5f00\u573a\u200b\u5438\u5f15\u200b - \u200b\u64ad\u653e\u200b\u8bad\u7ec3\u200b\u597d\u200b\u7684\u200b\u81ea\u52a8\u200b\u9a7e\u9a76\u200b\u6548\u679c\u200b\u89c6\u9891\u200b - \u200b\u63d0\u51fa\u200b\u6838\u5fc3\u200b\u95ee\u9898\u200b\uff1aAI\u200b\u662f\u200b\u5982\u4f55\u200b\u5728\u200b\u590d\u6742\u200b\u4ea4\u901a\u200b\u4e2d\u200b\u5b66\u4e60\u200b\u7684\u200b\uff1f - \u200b\u5c55\u793a\u200b\u9879\u76ee\u200b\u7684\u200b\u6280\u672f\u521b\u65b0\u200b\u70b9\u200b</p> <p>\u200b\u7b2c\u200b3-5\u200b\u5206\u949f\u200b: \u200b\u6280\u672f\u200b\u539f\u7406\u200b - Frenet\u200b\u5750\u6807\u7cfb\u200b: \u200b\u7528\u200b\u56fe\u4f8b\u200b\u89e3\u91ca\u200b(s,d)\u200b\u5750\u6807\u200b\u7684\u200b\u4f18\u52bf\u200b - \u200b\u5f3a\u5316\u200b\u5b66\u4e60\u200b: \u200b\u4ece\u200b\u8bd5\u9519\u200b\u5230\u200b\u6700\u4f18\u200b\u7b56\u7565\u200b\u7684\u200b\u5b66\u4e60\u200b\u8fc7\u7a0b\u200b - CARLA\u200b\u4eff\u771f\u200b: \u200b\u4e3a\u4ec0\u4e48\u200b\u9700\u8981\u200b\u4eff\u771f\u200b\u73af\u5883\u200b\uff1f</p> <p>\u200b\u7b2c\u200b6-8\u200b\u5206\u949f\u200b: \u200b\u7cfb\u7edf\u200b\u6f14\u793a\u200b - \u200b\u73b0\u573a\u200b\u542f\u52a8\u200bCARLA\u200b\u670d\u52a1\u5668\u200b - \u200b\u8fd0\u884c\u200b\u9884\u200b\u8bad\u7ec3\u200b\u6a21\u578b\u200b - \u200b\u5b9e\u65f6\u200b\u5c55\u793a\u200bAI\u200b\u51b3\u7b56\u200b\u8fc7\u7a0b\u200b - \u200b\u89e3\u91ca\u200b\u5173\u952e\u200b\u53c2\u6570\u200b\u7684\u200b\u5f71\u54cd\u200b</p> <p>\u200b\u7b2c\u200b9-11\u200b\u5206\u949f\u200b: \u200b\u5b9e\u9a8c\u200b\u7ed3\u679c\u200b - \u200b\u5c55\u793a\u200b\u8bad\u7ec3\u200b\u66f2\u7ebf\u200b - \u200b\u5bf9\u6bd4\u200b\u4e0d\u540c\u200b\u7b97\u6cd5\u200b\u8868\u73b0\u200b - \u200b\u5206\u6790\u200bFrenet\u200b\u65b9\u6cd5\u200b\u7684\u200b\u4f18\u52bf\u200b</p> <p>\u200b\u7b2c\u200b12-14\u200b\u5206\u949f\u200b: \u200b\u5e94\u7528\u200b\u524d\u666f\u200b - \u200b\u81ea\u52a8\u200b\u9a7e\u9a76\u200b\u6280\u672f\u200b\u53d1\u5c55\u8d8b\u52bf\u200b - \u200b\u9879\u76ee\u200b\u5728\u200b\u5b9e\u9645\u200b\u4e2d\u200b\u7684\u200b\u5e94\u7528\u200b\u6f5c\u529b\u200b - \u200b\u5b66\u751f\u200b\u53ef\u4ee5\u200b\u505a\u200b\u4ec0\u4e48\u200b\u9879\u76ee\u200b\uff1f</p> <p>\u200b\u7b2c\u200b15\u200b\u5206\u949f\u200b: \u200b\u603b\u7ed3\u200b\u4e92\u52a8\u200b - \u200b\u6838\u5fc3\u200b\u8981\u70b9\u200b\u56de\u987e\u200b - Q&amp;A\u200b\u73af\u8282\u200b - \u200b\u540e\u7eed\u200b\u5b66\u4e60\u200b\u5efa\u8bae\u200b</p>"},{"location":"#_32","title":"\u6f14\u793a\u200b\u6280\u5de7","text":"<p>\u200b\u5438\u5f15\u200b\u6ce8\u610f\u529b\u200b\u7684\u200b\u65b9\u6cd5\u200b: 1. \u200b\u89c6\u89c9\u200b\u51b2\u51fb\u200b: \u200b\u4f7f\u7528\u200b3D\u200b\u53ef\u89c6\u5316\u200b\u5c55\u793a\u200bAI\u200b\u51b3\u7b56\u200b 2. \u200b\u5bf9\u6bd4\u200b\u5c55\u793a\u200b: \u200b\u4f20\u7edf\u200b\u65b9\u6cd5\u200b vs AI\u200b\u65b9\u6cd5\u200b\u7684\u200b\u6548\u679c\u200b\u5bf9\u6bd4\u200b 3. \u200b\u5b9e\u65f6\u200b\u4ea4\u4e92\u200b: \u200b\u8c03\u6574\u200b\u53c2\u6570\u200b\u89c2\u5bdf\u200bAI\u200b\u884c\u4e3a\u200b\u53d8\u5316\u200b 4. \u200b\u573a\u666f\u200b\u6311\u6218\u200b: \u200b\u589e\u52a0\u200b\u4ea4\u901a\u200b\u590d\u6742\u5ea6\u200b\u6d4b\u8bd5\u200bAI\u200b\u6781\u9650\u200b</p> <p>\u200b\u6280\u672f\u200b\u8bb2\u89e3\u200b\u8981\u70b9\u200b: 1. \u200b\u4ece\u200b\u95ee\u9898\u200b\u51fa\u53d1\u200b: \u200b\u4e3a\u4ec0\u4e48\u200b\u9700\u8981\u200b\u8fd9\u4e2a\u200b\u9879\u76ee\u200b\uff1f 2. \u200b\u4ece\u200b\u7b80\u5230\u7e41\u200b: \u200b\u5148\u8bb2\u200b\u57fa\u7840\u200b\u6982\u5ff5\u200b\uff0c\u200b\u518d\u200b\u8bb2\u200b\u590d\u6742\u200b\u6280\u672f\